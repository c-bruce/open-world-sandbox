{
  "name": "open-world-sandbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "depcruise": "depcruise src",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run depcruise"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
